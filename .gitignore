# ============================================
# WSL Manager GUI - .gitignore
# ============================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.venvs/

# --- Build / Packaging ---
*.egg-info/
*.egg
.eggs/
dist/
build/
*.whl
*.tar.gz
*.zip

# --- Testing / Quality ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/
.mypy/
.tox/
.nox/

# --- Local configuration (may contain secrets) ---
config.json

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.key
*.pem
*.local
secrets.json

# --- Backup files ---
*.bak
*.swp
*.swo
*~

# --- Security evidence (pentest artifacts) ---
security/evidence/

# --- Database ---
metrics.db

# --- Logs ---
*.log
logs/
npm-debug.log*

# --- IDE / Editor ---
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace
.vscode-server/

# --- OS generated ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
desktop.ini

# --- Other tools ---
node_modules/
.pm2/
.pnp/
.pnp.js
*.exe
*.pid
